root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
# Markdown commonly wraps numbered list items with a 3-space continuation
# indent. The CommonMark convention takes precedence over a fixed indent_size.
indent_size = unset

[*.{yml,yaml,json,json5,toml}]
indent_size = 2

[*.py]
# Matches the ruff configuration in pyproject.toml.
indent_size = 4
max_line_length = 100

[*.{sh,bash,bats}]
indent_size = 2

[Makefile]
indent_style = tab
