RELAY_AUDIT_LOG_DIR=/var/log/relay-shell
RELAY_AUDIT_APPROVALS=/etc/relay-shell/audit-approved-resets.json
RELAY_AUDIT_RSYNC_DEST=backup-host:/var/backups/relay-shell/
RELAY_AUDIT_RSYNC_CHOWN=
RELAY_AUDIT_SSH_KNOWN_HOSTS=/var/lib/relay-shell/.ssh/known_hosts
# Command run on the backup host. The default is plain `rsync`, so the backup account must be
# able to write the destination. `sudo -n /usr/bin/rsync` (root-owned files) gives a
# compromised audited host root-equivalent write there; use it only if you need it.
# RELAY_AUDIT_RSYNC_PATH=rsync
# pull: refuse to publish a chain that is behind or forked from the remote anchor (needs read
# access to the destination). off: for a write-only destination (forced command rrsync -wo).
RELAY_AUDIT_REMOTE_CHECK=pull
# Rotated segments logrotate keeps (`rotate N` in /etc/logrotate.d/relay-shell). Pruning the
# oldest segments is accepted only while this many rotated segments remain.
RELAY_AUDIT_RETAIN_SEGMENTS=90
