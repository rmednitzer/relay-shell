{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "schedule:weekly"
  ],
  "timezone": "Europe/Vienna",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": false,
    "description": "Complete lock refreshes require review because they can change transitive dependencies across version boundaries."
  },
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "description": "Security remediation bypasses the routine update window and release-age delay; update-type review rules still apply."
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Allow Renovate itself to merge only after all checks, including its minimum-release-age status, pass; GitHub platform auto-merge does not reliably gate on this non-required status.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group all GitHub Actions updates so concurrent bumps do not collide on the same workflow files. separateMajorMinor is on by default, so majors still split into their own 'github-actions (major)' PR, which the major rule below labels and keeps out of automerge.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Python dependency updates into a single PR.",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip-compile",
        "poetry",
        "setup-cfg"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python dependencies"
    },
    {
      "description": "Major updates: separate, labelled, never automerged, across every manager. Majors already fail to match the automerge rule above, so automerge is false by default; it is stated for the same reason as lockFileMaintenance. This rule deliberately carries no matchManagers so that a major GitHub Actions, Docker, or Terraform bump is labelled for review like a major code dependency.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-review"
      ]
    },
    {
      "description": "Group pre-commit hook updates into one PR.",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Update the exact Ruff dependency, CI command, and pre-commit hook together to prevent formatter version drift.",
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff-pre-commit"
      ],
      "groupName": "ruff toolchain"
    },
    {
      "description": "Keep build, release and auxiliary jobs on the tested Python line until CI support and hashed build locks are updated together.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python",
        "actions/python-versions"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Generated tooling outputs belong to pip-compile so version and hash regeneration stay coupled.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-build.txt",
        "requirements-sbom.txt",
        "requirements-audit.txt",
        "requirements/*.txt"
      ],
      "enabled": false
    },
    {
      "description": "Review complete hashed build and SBOM closure refreshes before integration.",
      "matchManagers": [
        "pip-compile"
      ],
      "automerge": false,
      "platformAutomerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track exact Python package pins embedded in CI workflow commands.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\b(?<depName>[A-Za-z][A-Za-z0-9_.-]*)(?:\\[[A-Za-z0-9_,.-]+\\])?==(?<currentValue>\\d+\\.\\d+(?:\\.[0-9A-Za-z-]+)*)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Track exact npm CLI pins invoked through npx in CI workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "npx\\s+(?:-y|--yes)\\s+(?:--package\\s+)?(?<depName>[A-Za-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the Caddy prerequisite used by the real edge-routing CI tests.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/caddyserver/caddy/v2/cmd/caddy@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "caddyserver/caddy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "pruneStaleBranches": true,
  "pruneBranchAfterAutomerge": true,
  "pre-commit": {
    "enabled": true
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements-(?:build|sbom|audit)\\.txt$/",
      "/^requirements/(?:runtime|development)-py3\\.(?:12|13|14)\\.txt$/"
    ]
  }
}
